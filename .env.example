# ==============================================================================
# Real-Time Industrial Defect Detection System — Environment Configuration
# ==============================================================================
# Copy this file to .env and modify as needed.
# All values below are defaults; override via environment variables or .env.

# ── API Settings ──
API_TITLE=Real-Time Industrial Defect Detection API
API_VERSION=0.2.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── Model Settings ──
MODEL_PATH=models/yolov8n_defects.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45
MODEL_DEVICE=auto

# ── Upload Settings ──
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=10

# ── Image Preprocessing ──
INPUT_IMAGE_WIDTH=640
INPUT_IMAGE_HEIGHT=640
NORMALIZE_IMAGES=true

# ── Logging ──
LOG_LEVEL=INFO
LOG_DIR=logs

# ── CORS ──
CORS_ORIGINS=*
